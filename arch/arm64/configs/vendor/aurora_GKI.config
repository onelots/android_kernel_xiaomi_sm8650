# Charger
CONFIG_MI_WIRELESS=y
CONFIG_MI_DTPT=y
CONFIG_MI_ENABLE_DP=y

# Debug
CONFIG_MI_DUMP_DISPLAY=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_QCOM_DYN_MINIDUMP_STACK=y
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_XLOGCHAR=m

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=m

# HWID
CONFIG_MI_HARDWARE_ID=m

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# ISP (Surge P2)
CONFIG_MIISP=m
CONFIG_MIISP_CHIP=y

# Joystick
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Laser ToF
CONFIG_STMVL53L5=m

# Net
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Product
CONFIG_TARGET_PRODUCT_AURORA=y

# RPMSG
CONFIG_RPMSG_VIRTIO=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

